<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             version="3.0">
    <persistence-unit name="sica-pu" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>com.sicaproject.sica.iam.infrastructure.adapter.out.persistence.RolEntity</class>
        <class>com.sicaproject.sica.iam.infrastructure.adapter.out.persistence.PermisoEntity</class>
        <class>com.sicaproject.sica.iam.infrastructure.adapter.out.persistence.UsuarioEntity</class>
        <class>com.sicaproject.sica.personas.infrastructure.adapter.out.persistence.PersonaEntity</class>
        <class>com.sicaproject.sica.empresas.infrastructure.adapter.out.persistence.EmpresaEntity</class>
        <class>com.sicaproject.sica.acceso.infrastructure.adapter.out.persistence.VisitaEntity</class>
        <class>com.sicaproject.sica.auditoria.infrastructure.adapter.out.persistence.BitacoraAuditoriaEntity</class>

        <properties>
            <!-- Se sobreescriben en runtime vía JpaConfig si hay variables de entorno -->
            <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:postgresql://localhost:5432/sica_db"/>
            <property name="jakarta.persistence.jdbc.user" value="sica_user"/>
            <property name="jakarta.persistence.jdbc.password" value="sica_pass"/>

            <!-- IMPORTANTE: "validate", NO "update" ni "create".
                 El esquema real vive en schema.sql. Hibernate solo verifica
                 que las entidades coincidan con las tablas ya creadas. -->
            <property name="hibernate.hbm2ddl.auto" value="validate"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>
