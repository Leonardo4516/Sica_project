<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.sicaproject.sica.ui.controller.FuncionarioController"
           fx:id="rootPane"
           stylesheets="@styles.css"
           prefWidth="1280" prefHeight="720">

    <BorderPane>
        <left>
            <VBox styleClass="sidebar" prefWidth="220">
                <padding><Insets top="24" right="14" bottom="24" left="14" /></padding>

                <Text text="SICA" styleClass="title-md" />
                <Text text="PANEL FUNCIONARIO" styleClass="subtitle" />

                <VBox spacing="4" prefWidth="1">
                    <VBox styleClass="nav-item, active">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="Visitas Pendientes" />
                        </HBox>
                    </VBox>
                    <VBox styleClass="nav-item">
                        <HBox alignment="CENTER_LEFT" spacing="10" onMouseClicked="#handleLogout">
                            <Label text="Cerrar Sesión" />
                        </HBox>
                    </VBox>
                </VBox>
            </VBox>
        </left>

        <center>
            <VBox spacing="24">
                <padding><Insets top="28" right="32" bottom="28" left="32" /></padding>

                <Text fx:id="txtUsuario" text="Bienvenido" styleClass="title-lg" />

                <Separator opacity="0.15" />

                <!-- Tabla de pendientes -->
                <StackPane styleClass="glass-panel" VBox.vgrow="ALWAYS">
                    <VBox styleClass="glass-panel-inner" spacing="14">
                        <HBox alignment="CENTER_LEFT">
                            <Text text="Solicitudes Pendientes de Aprobación" styleClass="title-md" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Button text="Refrescar" styleClass="btn, btn-secondary" onAction="#handleRefresh" />
                        </HBox>
                        <TableView fx:id="tblPendientes" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colId" text="ID" prefWidth="60" />
                                <TableColumn fx:id="colPersona" text="Persona" prefWidth="200" />
                                <TableColumn fx:id="colEmpresa" text="Empresa" prefWidth="180" />
                                <TableColumn fx:id="colFecha" text="Fecha" prefWidth="150" />
                                <TableColumn fx:id="colTipo" text="Tipo" prefWidth="130" />
                                <TableColumn fx:id="colAcciones" text="Acciones" prefWidth="200" />
                            </columns>
                        </TableView>
                    </VBox>
                </StackPane>

                <!-- Formulario de pre-registro -->
                <StackPane styleClass="glass-panel" prefHeight="200">
                    <VBox styleClass="glass-panel-inner" spacing="14">
                        <Text text="Pre-registrar Visita Autorizada" styleClass="title-md" />

                        <HBox spacing="14" alignment="BOTTOM_LEFT">
                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <Label text="Nombre Persona" styleClass="label-text" />
                                <TextField fx:id="txtNombre" promptText="Nombre completo" />
                            </VBox>
                            <VBox spacing="6" prefWidth="240">
                                <Label text="Empresa Destino" styleClass="label-text" />
                                <ComboBox fx:id="cmbEmpresa" prefWidth="240" />
                            </VBox>
                            <VBox spacing="6" alignment="BOTTOM_LEFT">
                                <CheckBox fx:id="chkPaseTemporal" text="Pase temporal" />
                            </VBox>
                            <Button text="Pre-registrar" styleClass="btn, btn-primary" onAction="#handleRegistrar" />
                        </HBox>

                        <Label fx:id="lblMsg" styleClass="label-text" wrapText="true" />
                    </VBox>
                </StackPane>
            </VBox>
        </center>

        <bottom>
            <HBox styleClass="status-bar">
                <Text text="SICA — Panel de Funcionario" />
            </HBox>
        </bottom>
    </BorderPane>

</StackPane>