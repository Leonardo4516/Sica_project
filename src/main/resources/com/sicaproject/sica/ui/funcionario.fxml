<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.sicaproject.sica.ui.controller.FuncionarioController"
           fx:id="rootPane"
           stylesheets="@styles.css"
           prefWidth="1280" prefHeight="720">

    <BorderPane>
        <left>
            <VBox styleClass="sidebar" prefWidth="220">
                <padding><Insets top="24" right="14" bottom="24" left="14" /></padding>

                <Text text="SICA" styleClass="title-md" />
                <Text text="PANEL FUNCIONARIO" styleClass="subtitle" />

                <VBox spacing="6">
                    <VBox styleClass="nav-item, active">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="Visitas Pendientes" />
                        </HBox>
                    </VBox>
                    <VBox styleClass="nav-item" onMouseClicked="#handleLogout">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="Cerrar Sesion" />
                        </HBox>
                    </VBox>
                </VBox>
            </VBox>
        </left>

        <center>
            <VBox spacing="20">
                <padding><Insets top="24" right="28" bottom="24" left="28" /></padding>

                <Text fx:id="txtUsuario" text="Bienvenido" styleClass="title-lg" />

                <Separator opacity="0.15" />

                <!-- Tabla de pendientes -->
                <StackPane styleClass="glass-panel" VBox.vgrow="ALWAYS">
                    <VBox styleClass="glass-panel-inner" spacing="12">
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Text text="Solicitudes Pendientes de Aprobacion" styleClass="title-md" />
                            <Region HBox.hgrow="ALWAYS" />
                            <TextField fx:id="txtBuscarPendientes" promptText="🔍 Buscar por ID, documento, persona, empresa..." prefWidth="380" styleClass="search-field" />
                            <Button text="Refrescar" styleClass="btn, btn-secondary" onAction="#handleRefresh" />
                        </HBox>
                        <TableView fx:id="tblPendientes" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colId" text="ID" prefWidth="50" />
                                <TableColumn fx:id="colDocumento" text="Documento" prefWidth="130" />
                                <TableColumn fx:id="colPersona" text="Persona" prefWidth="200" />
                                <TableColumn fx:id="colEmpresa" text="Empresa" prefWidth="180" />
                                <TableColumn fx:id="colFecha" text="Fecha Registro" prefWidth="150" />
                                <TableColumn fx:id="colTipo" text="Tipo" prefWidth="100" />
                                <TableColumn fx:id="colVisitas" text="Visitas" prefWidth="70" />
                                <TableColumn fx:id="colAcciones" text="Acciones de Autorizacion" prefWidth="240" />
                            </columns>
                        </TableView>
                    </VBox>
                </StackPane>

                <!-- Formulario de pre-registro -->
                <StackPane styleClass="glass-panel" prefHeight="190">
                    <VBox styleClass="glass-panel-inner" spacing="12">
                        <Text text="Pre-registrar Visita Autorizada" styleClass="title-md" />

                        <HBox spacing="14" alignment="BOTTOM_LEFT">
                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <Label text="Nombre Persona" styleClass="label-text" />
                                <TextField fx:id="txtNombre" promptText="Nombre completo del invitado o trabajador" />
                            </VBox>
                            <VBox spacing="6">
                                <Label text="Tipo de documento" styleClass="label-text" />
                                <HBox spacing="10" alignment="CENTER_LEFT">
                                    <RadioButton fx:id="rbCC" text="CC" />
                                    <RadioButton fx:id="rbCE" text="CE" />
                                    <RadioButton fx:id="rbPasaporte" text="Pasaporte" />
                                </HBox>
                            </VBox>
                            <VBox spacing="6">
                                <Label text="Tipo de persona" styleClass="label-text" />
                                <HBox spacing="10" alignment="CENTER_LEFT">
                                    <RadioButton fx:id="rbTrabajador" text="Trabajador" />
                                    <RadioButton fx:id="rbInvitado" text="Invitado" />
                                </HBox>
                            </VBox>
                            <VBox spacing="6" prefWidth="240">
                                <Label text="Empresa Destino" styleClass="label-text" />
                                <ComboBox fx:id="cmbEmpresa" maxWidth="Infinity" />
                            </VBox>
                            <VBox spacing="6" alignment="BOTTOM_LEFT" prefWidth="180">
                                <Label text="Numero de documento" styleClass="label-text" />
                                <TextField fx:id="txtDocumento" promptText="Documento" />
                            </VBox>
                            <Button text="Pre-registrar" styleClass="btn, btn-primary" onAction="#handleRegistrar" />
                        </HBox>

                        <Label fx:id="lblMsg" styleClass="label-text" />
                    </VBox>
                </StackPane>
            </VBox>
        </center>

        <bottom>
            <HBox styleClass="status-bar">
                <Text text="SICA — Panel de Funcionario Anfitrion" />
            </HBox>
        </bottom>
    </BorderPane>

</StackPane>