<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.sicaproject.sica.ui.controller.BitacoraController"
           fx:id="rootPane"
           stylesheets="@styles.css"
           prefWidth="1280" prefHeight="720">

    <BorderPane>
        <left>
            <VBox styleClass="sidebar" prefWidth="220">
                <padding><Insets top="24" right="14" bottom="24" left="14" /></padding>

                <Text text="SICA" styleClass="title-md" />
                <Text text="BITACORA" styleClass="subtitle" />

                <VBox spacing="6">
                    <VBox styleClass="nav-item" onMouseClicked="#handleAdmin">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="Volver a Admin" />
                        </HBox>
                    </VBox>
                    <VBox styleClass="nav-item" onMouseClicked="#handleLogout">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="Cerrar Sesion" />
                        </HBox>
                    </VBox>
                </VBox>
            </VBox>
        </left>

        <center>
            <VBox spacing="20">
                <padding><Insets top="24" right="28" bottom="24" left="28" /></padding>

                <Text text="Bitacora de Auditoria" styleClass="title-lg" />

                <Separator opacity="0.15" />

                <!-- Filtros -->
                <HBox spacing="14" alignment="CENTER_LEFT">
                    <VBox spacing="4">
                        <Label text="Desde" styleClass="label-text" />
                        <DatePicker fx:id="dpDesde" prefWidth="140" />
                    </VBox>
                    <VBox spacing="4">
                        <Label text="Hasta" styleClass="label-text" />
                        <DatePicker fx:id="dpHasta" prefWidth="140" />
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <Button text="Filtrar" styleClass="btn, btn-primary" onAction="#handleFiltrar" />
                    <Button text="Mostrar Todo" styleClass="btn, btn-secondary" onAction="#handleRefresh" />
                    <Button text="Exportar CSV" styleClass="btn, btn-secondary" onAction="#handleExportarCsv" />
                </HBox>

                <!-- Tabla -->
                <StackPane styleClass="glass-panel" VBox.vgrow="ALWAYS">
                    <VBox styleClass="glass-panel-inner" spacing="12">
                        <Text text="Eventos y Trazabilidad de Seguridad" styleClass="title-md" />
                        <TableView fx:id="tblBitacora" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colBFecha" text="Fecha / Hora" prefWidth="160" />
                                <TableColumn fx:id="colBUsuario" text="Usuario" prefWidth="90" />
                                <TableColumn fx:id="colBAccion" text="Accion Realizada" prefWidth="200" />
                                <TableColumn fx:id="colBRecurso" text="Recurso" prefWidth="120" />
                                <TableColumn fx:id="colBDetalle" text="Detalle de la Operacion" prefWidth="420" />
                                <TableColumn fx:id="colBResultado" text="Resultado" prefWidth="110" />
                            </columns>
                        </TableView>
                    </VBox>
                </StackPane>
            </VBox>
        </center>

        <bottom>
            <HBox styleClass="status-bar">
                <Text text="SICA — Bitacora Central de Auditoria" />
            </HBox>
        </bottom>
    </BorderPane>

</StackPane>