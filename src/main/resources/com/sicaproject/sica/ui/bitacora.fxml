<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.sicaproject.sica.ui.controller.BitacoraController"
           stylesheets="@styles.css"
           prefWidth="1280" prefHeight="720">

    <BorderPane>
        <left>
            <VBox styleClass="sidebar" prefWidth="220" spacing="6">
                <padding>
                    <Insets top="20" right="12" bottom="20" left="12" />
                </padding>
                <Text text="SICA" styleClass="title-md, brand-accent" />
                <Text text="Bitácora" styleClass="subtitle" margin="0 0 24 0" />
                <HBox styleClass="nav-item" alignment="CENTER_LEFT" spacing="10" onMouseClicked="#handleAdmin">
                    <Label text="🔐 Volver a Admin" />
                </HBox>
                <HBox styleClass="nav-item" alignment="CENTER_LEFT" spacing="10" onMouseClicked="#handleLogout">
                    <Label text="🚪 Cerrar Sesión" />
                </HBox>
            </VBox>
        </left>

        <center>
            <VBox spacing="20">
                <padding>
                    <Insets top="28" right="32" bottom="28" left="32" />
                </padding>

                <HBox alignment="CENTER_LEFT" spacing="20">
                    <VBox>
                        <Text text="Bitácora de, " styleClass="subtitle" />
                        <Text text="Auditoría" styleClass="title-lg" />
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="lblHora" text="00:00:00" styleClass="title-md, brand-accent" />
                </HBox>

                <Separator opacity="0.2" />

                <StackPane styleClass="glass-panel" prefHeight="80">
                    <HBox styleClass="glass-panel-inner" alignment="CENTER_LEFT" spacing="14">
                        <Label text="Desde:" styleClass="label-text" />
                        <DatePicker fx:id="dpDesde" />
                        <Label text="Hasta:" styleClass="label-text" />
                        <DatePicker fx:id="dpHasta" />
                        <Button text="🔍 Filtrar" styleClass="btn, btn-primary" onAction="#handleFiltrar" />
                        <Button text="🔄 Todo" styleClass="btn, btn-secondary" onAction="#handleRefresh" />
                    </HBox>
                </StackPane>

                <StackPane styleClass="glass-panel" VBox.vgrow="ALWAYS">
                    <VBox styleClass="glass-panel-inner" spacing="12">
                        <Text text="Eventos registrados" styleClass="title-md" />
                        <TableView fx:id="tblBitacora" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn text="Fecha/Hora" prefWidth="170" />
                                <TableColumn text="Usuario ID" prefWidth="90" />
                                <TableColumn text="Acción" prefWidth="180" />
                                <TableColumn text="Recurso" prefWidth="110" />
                                <TableColumn text="Detalle" prefWidth="380" />
                                <TableColumn text="Resultado" prefWidth="120" />
                            </columns>
                        </TableView>
                    </VBox>
                </StackPane>
            </VBox>
        </center>

        <bottom>
            <HBox styleClass="status-bar" alignment="CENTER_LEFT">
                <Text text="SICA © 2025 — Bitácora de auditoría" />
            </HBox>
        </bottom>
    </BorderPane>

</StackPane>
