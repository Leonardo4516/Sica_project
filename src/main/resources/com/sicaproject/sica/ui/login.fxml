<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.sicaproject.sica.ui.controller.LoginController"
           fx:id="rootPane"
           stylesheets="@styles.css"
           prefWidth="1280" prefHeight="720">

    <VBox alignment="CENTER" spacing="0">
        <StackPane styleClass="glass-panel" maxWidth="400" maxHeight="500">
            <VBox styleClass="glass-panel-inner" alignment="CENTER" spacing="0">
                <VBox spacing="0" alignment="CENTER">
                    <Text text="SICA" styleClass="title-xl" />
                    <Text text="Sistema Integrado de Control de Acceso" styleClass="subtitle" />
                </VBox>

                <Separator opacity="0.15" />

                <VBox spacing="20" alignment="CENTER" maxWidth="320" prefWidth="320">
                    <VBox spacing="8">
                        <Label text="Usuario" styleClass="label-text" />
                        <TextField fx:id="txtUsuario" promptText="Ingrese su usuario" />
                    </VBox>

                    <VBox spacing="8">
                        <Label text="Contraseña" styleClass="label-text" />
                        <PasswordField fx:id="txtPassword" promptText="Contraseña" />
                    </VBox>

                    <HBox alignment="CENTER">
                        <CheckBox fx:id="chkRecordar" text="Recordar sesión" />
                    </HBox>

                    <Label fx:id="lblError" styleClass="label-text" opacity="0" wrapText="true" maxWidth="320" />
                </VBox>

                <Separator opacity="0.15" />

                <Button fx:id="btnLogin" text="Iniciar Sesión" styleClass="btn, btn-primary" prefWidth="320" onAction="#handleLogin" />
            </VBox>
        </StackPane>

        <Text text="© 2026 SICA — Sistema Integrado de Control de Acceso" styleClass="subtitle" StackPane.alignment="BOTTOM_CENTER" />
    </VBox>

</StackPane>