<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.sicaproject.sica.ui.controller.LoginController"
           fx:id="rootPane"
           stylesheets="@styles.css"
           prefWidth="1280" prefHeight="720">

    <!-- Canvas de particulas en segundo plano exclusivo de login -->
    <Canvas fx:id="canvasParticles" mouseTransparent="true" />

    <VBox alignment="CENTER" spacing="24">
        <StackPane styleClass="glass-panel" maxWidth="440" maxHeight="560">
            <VBox styleClass="glass-panel-inner" alignment="CENTER" spacing="16">
                <padding><Insets top="28" right="32" bottom="28" left="32" /></padding>
                <VBox spacing="4" alignment="CENTER">
                    <Text text="SICA" styleClass="title-xl" />
                    <Text text="Sistema Integrado de Control de Acceso" styleClass="subtitle" />
                    <Text text="Complejo Empresarial Zona Acme" styleClass="subtitle" style="-fx-fill: #818cf8; -fx-font-weight: bold;" />
                </VBox>

                <Separator opacity="0.15" />

                <VBox spacing="16" alignment="CENTER_LEFT" maxWidth="360" prefWidth="360">
                    <VBox spacing="6">
                        <Label text="Usuario" styleClass="label-text" />
                        <TextField fx:id="txtUsuario" promptText="Usuario" />
                    </VBox>

                    <VBox spacing="6">
                        <Label text="Contraseña" styleClass="label-text" />
                        <PasswordField fx:id="txtPassword" promptText="Contraseña" />
                    </VBox>

                    <HBox alignment="CENTER_LEFT">
                        <CheckBox fx:id="chkRecordar" text="Recordar sesión en este equipo" />
                    </HBox>

                    <Label fx:id="lblError" styleClass="label-text" opacity="0" wrapText="true" maxWidth="360" style="-fx-text-fill: #ef4444; -fx-font-weight: bold;" />
                </VBox>

                <Separator opacity="0.15" />

                <Button fx:id="btnLogin" text="Iniciar Sesión" styleClass="btn, btn-primary" prefWidth="360" onAction="#handleLogin" />
            </VBox>
        </StackPane>

        <Text text="SICA — Seguridad Perimetral y Gestión de Accesos" styleClass="subtitle" StackPane.alignment="BOTTOM_CENTER" />
    </VBox>

</StackPane>