<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/javafx/fxml"
           fx:controller="com.sicaproject.sica.ui.controller.GuardaController"
           fx:id="rootPane"
           stylesheets="@styles.css"
           prefWidth="1280" prefHeight="720">

    <BorderPane>
        <left>
            <VBox styleClass="sidebar" prefWidth="220">
                <padding><Insets top="24" right="14" bottom="24" left="14" /></padding>

                <Text text="SICA" styleClass="title-md" />
                <Text text="CONTROL DE ACCESO" styleClass="subtitle" />

                <VBox spacing="4">
                    <VBox styleClass="nav-item, active">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="Inicio" />
                        </HBox>
                    </VBox>
                    <VBox styleClass="nav-item">
                        <HBox alignment="CENTER_LEFT" spacing="10" onMouseClicked="#handleLogout">
                            <Label text="Cerrar Sesión" />
                        </HBox>
                    </VBox>
                </VBox>
            </VBox>
        </left>

        <center>
            <VBox spacing="24">
                <padding><Insets top="28" right="32" bottom="28" left="32" /></padding>

                <Text fx:id="txtUsuario" text="Bienvenido" styleClass="title-lg" />

                <Separator opacity="0.15" />

                <!-- Formularios -->
                <HBox spacing="20" alignment="TOP_LEFT">
                    <!-- Check-in / Check-out -->
                    <VBox styleClass="glass-panel" prefWidth="360">
                        <VBox styleClass="glass-panel-inner" spacing="14">
                            <Text text="Registro de Acceso" styleClass="title-md" />

                            <VBox spacing="6">
                                <Label text="Check-in (ingreso)" styleClass="label-text" />
                                <HBox spacing="8">
                                    <TextField fx:id="txtVisitaIdIn" promptText="ID de visita" HBox.hgrow="ALWAYS" />
                                    <Button fx:id="btnCheckIn" text="Ingresar" styleClass="btn, btn-success" onAction="#handleCheckIn" />
                                </HBox>
                                <Label fx:id="lblInMsg" styleClass="label-text" wrapText="true" />
                            </VBox>

                            <Separator opacity="0.15" />

                            <VBox spacing="6">
                                <Label text="Check-out (salida)" styleClass="label-text" />
                                <HBox spacing="8">
                                    <TextField fx:id="txtVisitaIdOut" promptText="ID de visita" HBox.hgrow="ALWAYS" />
                                    <Button fx:id="btnCheckOut" text="Salir" styleClass="btn, btn-danger" onAction="#handleCheckOut" />
                                </HBox>
                                <Label fx:id="lblOutMsg" styleClass="label-text" wrapText="true" />
                            </VBox>
                        </VBox>
                    </VBox>

                    <!-- Nueva Solicitud -->
                    <VBox styleClass="glass-panel" HBox.hgrow="ALWAYS">
                        <VBox styleClass="glass-panel-inner" spacing="14">
                            <Text text="Nueva Solicitud de Acceso" styleClass="title-md" />

                            <VBox spacing="6">
                                <Label text="Nombre completo" styleClass="label-text" />
                                <TextField fx:id="txtNombreSolicitud" promptText="Nombre del visitante" />
                            </VBox>

                            <HBox spacing="12">
                                <VBox spacing="6" prefWidth="160">
                                    <Label text="Tipo de documento" styleClass="label-text" />
                                    <HBox spacing="4">
                                        <RadioButton fx:id="rbCC" text="CC" toggleGroup="$tgDoc" selected="true" />
                                        <RadioButton fx:id="rbCE" text="CE" toggleGroup="$tgDoc" />
                                        <RadioButton fx:id="rbPasaporte" text="Pasaporte" toggleGroup="$tgDoc" />
                                    </HBox>
                                </VBox>
                                <VBox spacing="6" HBox.hgrow="ALWAYS">
                                    <Label text="Número de documento" styleClass="label-text" />
                                    <HBox spacing="8">
                                        <TextField fx:id="txtDocSolicitud" promptText="1321321" HBox.hgrow="ALWAYS" />
                                        <Button fx:id="btnBuscar" text="Buscar" styleClass="btn, btn-secondary" onAction="#handleBuscarPersona" />
                                    </HBox>
                                </VBox>
                            </HBox>

                            <VBox spacing="6">
                                <Label text="Tipo de persona" styleClass="label-text" />
                                <HBox spacing="4">
                                    <RadioButton fx:id="rbTrabajador" text="Trabajador" toggleGroup="$tgPersona" />
                                    <RadioButton fx:id="rbInvitado" text="Invitado" toggleGroup="$tgPersona" selected="true" />
                                </HBox>
                            </VBox>

                            <HBox spacing="12">
                                <VBox spacing="6" HBox.hgrow="ALWAYS">
                                    <Label text="Empresa destino" styleClass="label-text" />
                                    <ComboBox fx:id="cmbEmpresaSolicitud" maxWidth="Infinity" />
                                </VBox>
                                <VBox spacing="6" HBox.hgrow="ALWAYS">
                                    <Label text="Funcionario anfitrión" styleClass="label-text" />
                                    <ComboBox fx:id="cmbFuncionarioSolicitud" maxWidth="Infinity" />
                                </VBox>
                            </HBox>

                            <HBox spacing="14" alignment="CENTER_LEFT">
                                <CheckBox fx:id="chkPaseTemporalSolicitud" text="Pase temporal (carnet olvidado)" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Button fx:id="btnSolicitar" text="Solicitar" styleClass="btn, btn-primary" onAction="#handleSolicitarAcceso" />
                            </HBox>

                            <Label fx:id="lblSolicitudMsg" styleClass="label-text" wrapText="true" />
                        </VBox>
                    </VBox>
                </HBox>

                <!-- Tablas -->
                <StackPane styleClass="glass-panel" VBox.vgrow="ALWAYS">
                    <VBox styleClass="glass-panel-inner" spacing="14">
                        <HBox alignment="CENTER_LEFT">
                            <Text text="Visitas" styleClass="title-md" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Button text="Refrescar" styleClass="btn, btn-secondary" onAction="#handleRefresh" />
                            <Button text="Bloquear / Desbloquear" styleClass="btn, btn-warning" onAction="#handleToggleBloqueo" />
                        </HBox>
                        <TabPane fx:id="tabPaneVisitas" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">

                            <Tab text="Activas (dentro)">
                                <VBox spacing="8">
                                    <padding><Insets top="14" /></padding>
                                    <TableView fx:id="tblActivas" VBox.vgrow="ALWAYS">
                                        <columns>
                                            <TableColumn fx:id="colGId" text="ID" prefWidth="50" />
                                            <TableColumn fx:id="colGPersona" text="Visitante" prefWidth="200" />
                                            <TableColumn fx:id="colGEmpresa" text="Empresa" prefWidth="200" />
                                            <TableColumn fx:id="colGHora" text="Hora entrada" prefWidth="150" />
                                            <TableColumn fx:id="colGEstado" text="Estado" prefWidth="120" />
                                        </columns>
                                    </TableView>
                                </VBox>
                            </Tab>

                            <Tab text="Aprobadas (para ingreso)">
                                <VBox spacing="8">
                                    <padding><Insets top="14" /></padding>
                                    <TableView fx:id="tblAprobadas" VBox.vgrow="ALWAYS">
                                        <columns>
                                            <TableColumn fx:id="colAId" text="ID" prefWidth="50" />
                                            <TableColumn fx:id="colAPersona" text="Visitante" prefWidth="200" />
                                            <TableColumn fx:id="colAEmpresa" text="Empresa" prefWidth="200" />
                                            <TableColumn fx:id="colAHora" text="Hora registro" prefWidth="150" />
                                            <TableColumn fx:id="colATipo" text="Tipo" prefWidth="120" />
                                        </columns>
                                    </TableView>
                                </VBox>
                            </Tab>

                            <Tab text="Pendientes (por aprobar)">
                                <VBox spacing="8">
                                    <padding><Insets top="14" /></padding>
                                    <TableView fx:id="tblPendientes" VBox.vgrow="ALWAYS">
                                        <columns>
                                            <TableColumn fx:id="colPId" text="ID" prefWidth="50" />
                                            <TableColumn fx:id="colPPersona" text="Visitante" prefWidth="200" />
                                            <TableColumn fx:id="colPEmpresa" text="Empresa" prefWidth="200" />
                                            <TableColumn fx:id="colPHora" text="Hora registro" prefWidth="150" />
                                            <TableColumn fx:id="colPTipo" text="Tipo" prefWidth="120" />
                                        </columns>
                                    </TableView>
                                </VBox>
                            </Tab>

                        </TabPane>
                    </VBox>
                </StackPane>
            </VBox>
        </center>

        <bottom>
            <HBox styleClass="status-bar">
                <Text text="SICA — Panel de Control de Acceso" />
            </HBox>
        </bottom>
    </BorderPane>

</StackPane>
