<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.sicaproject.sica.ui.controller.GuardaController"
           fx:id="rootPane"
           stylesheets="@styles.css"
           prefWidth="1280" prefHeight="720">

    <BorderPane>
        <left>
            <VBox styleClass="sidebar" prefWidth="220">
                <padding><Insets top="24" right="14" bottom="24" left="14" /></padding>

                <Text text="SICA" styleClass="title-md" />
                <Text text="CONTROL DE ACCESO" styleClass="subtitle" />

                <VBox spacing="6">
                    <VBox styleClass="nav-item, active">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="Panel Principal" />
                        </HBox>
                    </VBox>
                    <VBox styleClass="nav-item" onMouseClicked="#handleLogout">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="Cerrar Sesion" />
                        </HBox>
                    </VBox>
                </VBox>
            </VBox>
        </left>

        <center>
            <VBox spacing="20">
                <padding><Insets top="24" right="28" bottom="24" left="28" /></padding>

                <HBox alignment="CENTER_LEFT">
                    <Text fx:id="txtUsuario" text="Bienvenido" styleClass="title-lg" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button text="Reportar Incidente" styleClass="btn, btn-danger" onAction="#handleReportarIncidente" />
                </HBox>

                <Separator opacity="0.15" />

                <!-- Formularios -->
                <HBox spacing="18" alignment="TOP_LEFT">
                    <!-- Check-in / Check-out -->
                    <VBox styleClass="glass-panel" prefWidth="380">
                        <VBox styleClass="glass-panel-inner" spacing="14">
                            <Text text="Registro de Ingreso y Salida" styleClass="title-md" />

                            <VBox spacing="6">
                                <Label text="Check-in (Ingreso con ID de visita)" styleClass="label-text" />
                                <HBox spacing="8">
                                    <TextField fx:id="txtVisitaIdIn" promptText="ID de visita" HBox.hgrow="ALWAYS" />
                                    <Button fx:id="btnCheckIn" text="Ingresar" styleClass="btn, btn-success" onAction="#handleCheckIn" />
                                </HBox>
                                <HBox spacing="10">
                                    <ImageView fx:id="imgFotoVisitanteIn" fitWidth="100" fitHeight="100" preserveRatio="true" />
                                    <Label fx:id="lblInMsg" styleClass="label-text" wrapText="true" />
                                </HBox>
                            </VBox>

                            <Separator opacity="0.15" />

                            <VBox spacing="6">
                                <Label text="Check-out (Salida)" styleClass="label-text" />
                                <HBox spacing="8">
                                    <TextField fx:id="txtVisitaIdOut" promptText="ID de visita" HBox.hgrow="ALWAYS" />
                                    <Button fx:id="btnCheckOut" text="Registrar Salida" styleClass="btn, btn-danger" onAction="#handleCheckOut" />
                                </HBox>
                                <HBox spacing="10">
                                    <ImageView fx:id="imgFotoVisitanteOut" fitWidth="100" fitHeight="100" preserveRatio="true" />
                                    <Label fx:id="lblOutMsg" styleClass="label-text" wrapText="true" />
                                </HBox>
                            </VBox>
                        </VBox>
                    </VBox>

                    <!-- Nueva Solicitud -->
                    <VBox styleClass="glass-panel" HBox.hgrow="ALWAYS">
                        <VBox styleClass="glass-panel-inner" spacing="12">
                            <Text text="Solicitud de Acceso en Porteria" styleClass="title-md" />

                            <HBox spacing="12">
                                <VBox spacing="6" HBox.hgrow="ALWAYS">
                                    <Label text="Tipo de documento" styleClass="label-text" />
                                    <HBox spacing="12" alignment="CENTER_LEFT">
                                        <RadioButton fx:id="rbCC" text="CC" />
                                        <RadioButton fx:id="rbCE" text="CE" />
                                        <RadioButton fx:id="rbPasaporte" text="Pasaporte" />
                                    </HBox>
                                </VBox>
                                <VBox spacing="6" HBox.hgrow="ALWAYS">
                                    <Label text="Tipo de persona" styleClass="label-text" />
                                    <HBox spacing="12" alignment="CENTER_LEFT">
                                        <RadioButton fx:id="rbTrabajador" text="Trabajador" />
                                        <RadioButton fx:id="rbInvitado" text="Invitado" />
                                    </HBox>
                                </VBox>
                            </HBox>

                            <HBox spacing="10" alignment="BOTTOM_LEFT">
                                <VBox spacing="6" HBox.hgrow="ALWAYS">
                                    <Label text="Numero de documento" styleClass="label-text" />
                                    <TextField fx:id="txtDocSolicitud" promptText="Ingrese documento" />
                                </VBox>
                                <Button fx:id="btnBuscar" text="Buscar Persona" styleClass="btn, btn-secondary" onAction="#handleBuscarPersona" />
                            </HBox>

                            <VBox spacing="6">
                                <Label text="Nombre completo" styleClass="label-text" />
                                <TextField fx:id="txtNombreSolicitud" promptText="Nombre de la persona" />
                            </VBox>
                            
                            <VBox spacing="6">
                                <Label text="Fotografía" styleClass="label-text" />
                                <HBox spacing="10" alignment="CENTER_LEFT">
                                    <ImageView fx:id="imgFotoPreview" fitWidth="60" fitHeight="60" preserveRatio="true" />
                                    <Button text="Seleccionar Foto..." styleClass="btn, btn-secondary" onAction="#handleSeleccionarFoto" />
                                </HBox>
                            </VBox>

                            <HBox spacing="12">
                                <VBox spacing="6" HBox.hgrow="ALWAYS">
                                    <Label text="Empresa destino" styleClass="label-text" />
                                    <ComboBox fx:id="cmbEmpresaSolicitud" maxWidth="Infinity" />
                                </VBox>
                                <VBox spacing="6" HBox.hgrow="ALWAYS">
                                    <Label text="Funcionario anfitrion" styleClass="label-text" />
                                    <ComboBox fx:id="cmbFuncionarioSolicitud" maxWidth="Infinity" />
                                </VBox>
                            </HBox>

                            <HBox spacing="14" alignment="CENTER_LEFT">
                                <CheckBox fx:id="chkPaseTemporalSolicitud" text="Pase temporal (carnet olvidado)" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Button fx:id="btnSolicitar" text="Enviar Solicitud" styleClass="btn, btn-primary" onAction="#handleSolicitarAcceso" />
                            </HBox>

                            <Label fx:id="lblSolicitudMsg" styleClass="label-text" wrapText="true" />
                        </VBox>
                    </VBox>
                </HBox>

                <!-- Tablas -->
                <StackPane styleClass="glass-panel" VBox.vgrow="ALWAYS">
                    <VBox styleClass="glass-panel-inner" spacing="12">
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Text text="Control de Visitas" styleClass="title-md" />
                            <Region HBox.hgrow="ALWAYS" />
                            <TextField fx:id="txtBuscarVisita" promptText="🔍 Buscar por ID, documento, nombre, empresa..." prefWidth="380" styleClass="search-field" />
                            <Button text="Refrescar" styleClass="btn, btn-secondary" onAction="#handleRefresh" />
                        </HBox>
                        <TabPane fx:id="tabPaneVisitas" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">

                            <Tab text="Activas (Dentro del Complejo)">
                                <VBox spacing="8">
                                    <padding><Insets top="10" /></padding>
                                    <TableView fx:id="tblActivas" VBox.vgrow="ALWAYS">
                                        <columns>
                                            <TableColumn fx:id="colGId" text="ID" prefWidth="50" />
                                            <TableColumn fx:id="colGPersona" text="Visitante" prefWidth="220" />
                                            <TableColumn fx:id="colGEmpresa" text="Empresa" prefWidth="200" />
                                            <TableColumn fx:id="colGHora" text="Hora Entrada" prefWidth="150" />
                                            <TableColumn fx:id="colGEstado" text="Estado" prefWidth="120" />
                                        </columns>
                                    </TableView>
                                </VBox>
                            </Tab>

                            <Tab text="Aprobadas (Listas para Ingreso)">
                                <VBox spacing="8">
                                    <padding><Insets top="10" /></padding>
                                    <TableView fx:id="tblAprobadas" VBox.vgrow="ALWAYS">
                                        <columns>
                                            <TableColumn fx:id="colAId" text="ID" prefWidth="50" />
                                            <TableColumn fx:id="colAPersona" text="Visitante" prefWidth="220" />
                                            <TableColumn fx:id="colAEmpresa" text="Empresa" prefWidth="200" />
                                            <TableColumn fx:id="colAHora" text="Hora Registro" prefWidth="150" />
                                            <TableColumn fx:id="colATipo" text="Tipo" prefWidth="120" />
                                        </columns>
                                    </TableView>
                                </VBox>
                            </Tab>

                            <Tab text="Pendientes de Aprobacion">
                                <VBox spacing="8">
                                    <padding><Insets top="10" /></padding>
                                    <TableView fx:id="tblPendientes" VBox.vgrow="ALWAYS">
                                        <columns>
                                            <TableColumn fx:id="colPId" text="ID" prefWidth="50" />
                                            <TableColumn fx:id="colPPersona" text="Visitante" prefWidth="220" />
                                            <TableColumn fx:id="colPEmpresa" text="Empresa" prefWidth="200" />
                                            <TableColumn fx:id="colPHora" text="Hora Registro" prefWidth="150" />
                                            <TableColumn fx:id="colPTipo" text="Tipo" prefWidth="120" />
                                        </columns>
                                    </TableView>
                                </VBox>
                            </Tab>

                        </TabPane>
                    </VBox>
                </StackPane>
            </VBox>
        </center>

        <bottom>
            <HBox styleClass="status-bar">
                <Text text="SICA — Panel de Porteria y Control de Acceso" />
            </HBox>
        </bottom>
    </BorderPane>

</StackPane>
